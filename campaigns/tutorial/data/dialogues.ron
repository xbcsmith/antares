    (
        id: 6,
        name: "High Priestess Greeting",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "May the light find you, traveler. I am the High Priestess of this temple, and in these troubled times our doors have never been more needed. The Great Gloom that has pressed on the edges of Ashvale for generations grows bolder. We tend to the sick, protect the frightened, and hold a light that refuses to go out. Do you seek healing, guidance, or something else?",
                speaker_override: None,
                choices: [
                    (
                        text: "Tell me about the temple.",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "What guidance can you offer?",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Blessings to you as well.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Show me your wares.",
                        target_node: Some(6),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [
                                MerchantChoice,
                            ],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "This temple has stood for centuries as a sanctuary against the Great Gloom — the creeping darkness that hungers at the edges of the world. Where the Weave thins, the Gloom presses in. Our work is to hold the light steady in such places and tend to those the darkness has already touched.",
                speaker_override: None,
                choices: [
                    (
                        text: "Troubled times?",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell me more.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "The Gloom does not rest and neither do we. What grows strange in the old places, what walks out of the Harrow Downs, what reaches from the far north — these are not separate troubles but one wound in the fabric of the world. Stay true to the light in you, and that light will hold.",
                speaker_override: None,
                choices: [
                    (
                        text: "Thank you for your wisdom.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "What else can you tell me?",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "We have seen it before — the fraying at the edges of things, the shadows that learn to hunger. The Weave that holds the world together grows thin wherever the Gloom presses. We do what we can, but what presses from the north now is something more deliberate than shadow. Something chose to still the world.",
                speaker_override: None,
                choices: [
                    (
                        text: "I understand.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "Go with my blessing, brave one. May your journey be safe and your purpose true.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            6: (
                id: 6,
                text: "Of course. Here is what High Priestess Town Square is offering.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [
                    OpenMerchant(
                        npc_id: "tutorial_priestess_town",
                    ),
                ],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [
                        MerchantOpenNode,
                    ],
                ),
            ),
        },
        speaker_name: Some("High Priestess"),
        repeatable: true,
        associated_quest: None,
        sdk_metadata: (
            managed_content: [
                MerchantBranchInsertion,
            ],
        ),
    ),
    (
        id: 7,
        name: "Lost Ranger Quest",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "*looks up from a map scratched in the dirt, then exhales with relief* You have the look of people who know what they\'re doing. I\'ve been tracking unusual goblin movements for three days — not raids, patrols. Organized, with scouts ranging far ahead of the main group. Something is directing them. I lost my bearings when I followed them too deep into the forest and my compass started behaving strangely. I need help getting clear of here.",
                speaker_override: None,
                choices: [
                    (
                        text: "Where did this happen?",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We\'ll help you recover it.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "That\'s unfortunate. Good luck.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "The goblins moved southeast from deeper in the Dark Forest, where the Weave thins near the old places of power. They carried something — an instrument, arcane, taken from somewhere. Whatever directs them values that instrument more than any raid. I tried to follow. I should not have tried to follow alone.",
                speaker_override: None,
                choices: [
                    (
                        text: "We\'ll retrieve your bow.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "I can\'t help you.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "You\'d do that? Good. I need to report this to the Rangers Guild — the organized goblin movement is more serious than the villages realize. If you can help me navigate back to the road, I will tell you everything I observed. It may be useful where you are going.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "Understood. Perhaps the Rangers Guild will send someone better equipped. I hope the forest is done with its strange moods by the time they arrive.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
        },
        speaker_name: Some("Lost Ranger"),
        repeatable: false,
        associated_quest: Some(6),
        sdk_metadata: (
            managed_content: [],
        ),
    ),
    (
        id: 8,
        name: "Village Elder Mountain Pass - Lich Quest",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "You have the look of seasoned travelers. Good — because what troubles these lands is not simple banditry. The tombs of the Harrow Downs have begun opening from the inside, and the dead that walk out are not the restless kind. They are directed. Something old woke in those ruins, and worse — we hear word of a stillness spreading from far to the north. Two troubles at once. Which one concerns you more?",
                speaker_override: None,
                choices: [
                    (
                        text: "What kind of evil?",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We\'re ready to help.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "This sounds too dangerous.",
                        target_node: Some(6),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Show me your wares.",
                        target_node: Some(7),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [
                                MerchantChoice,
                            ],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "A powerful undead presence, old and patient. The tombs of an advanced civilization that built with craft we have not matched since — and something that sleeps in the deepest vault has begun stirring. Already the dead walk. Beyond that, rumor reaches us of an unnatural cold spreading from the Frostspire Peaks far to the north. Rivers freeze mid-current. Snow falls without wind. Something has stilled the land up there.",
                speaker_override: None,
                choices: [
                    (
                        text: "How do we stop it?",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We accept this quest.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "Bless you. Journey to the Harrow Downs and seal whatever has opened there. A reliquary was taken from a wizard named Arcturus — retrieve it while you investigate. And keep your ears open for word of the stillness spreading from the north. These troubles may share a root.",
                speaker_override: None,
                choices: [
                    (
                        text: "We won\'t fail.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "Search the Harrow Downs for what has opened. There will be a vault, a sealed reliquary that does not belong to the dead — recover it. The dead will quiet when the source of their direction is removed. Beyond that, watch the northern horizon. The stillness is patient and it spreads.",
                speaker_override: None,
                choices: [
                    (
                        text: "We\'ll do it.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "This is beyond us.",
                        target_node: Some(6),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "May the old gods watch over you. Return to me when the deed is done, and you shall be rewarded as befits such heroism.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            6: (
                id: 6,
                text: "I understand your caution. Few would willingly face such a foe. If you change your mind, I will be here. But know that time grows short.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            7: (
                id: 7,
                text: "Of course. Here is what Village Elder Mountain Pass is offering.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [
                    OpenMerchant(
                        npc_id: "tutorial_elder_village2",
                    ),
                ],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [
                        MerchantOpenNode,
                    ],
                ),
            ),
        },
        speaker_name: Some("Village Elder"),
        repeatable: false,
        associated_quest: Some(5),
        sdk_metadata: (
            managed_content: [
                MerchantBranchInsertion,
            ],
        ),
    ),
    (
        id: 9,
        name: "Innkeeper Mountain Pass Greeting",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "Well met, travelers! Welcome to the Mountain Rest. Not many come through this pass lately, what with the strange cold coming down from the north and the dead walking near the Harrow Downs. But my hearth is warm, the ale is cold, and I have been running this inn through worse. What can I do for you?",
                speaker_override: None,
                choices: [
                    (
                        text: "What kind of trouble?",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell me about the mountain pass.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "I\'d like to manage my party.",
                        target_node: Some(6),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Thanks for the welcome.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Show me your wares.",
                        target_node: Some(7),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [
                                MerchantChoice,
                            ],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "Both, truth be told. The dead are the closer problem — Harrow Downs is not far and I\'ve seen shapes on foggy nights I don\'t care to name. But the cold from the north is the stranger one. Travelers coming south say rivers freeze mid-current up there, snow falls without wind. Something has stilled the land.",
                speaker_override: None,
                choices: [
                    (
                        text: "That\'s concerning.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell me something else.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "This pass has been a trade route for generations. In better times, caravans daily. Now only the occasional brave soul. But the inn endures — four generations and a peculiar kind of cold that crept down from the north won\'t close our doors. Though I wouldn\'t say no to someone dealing with one or both problems.",
                speaker_override: None,
                choices: [
                    (
                        text: "Sounds like things have changed.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "Aye, they have. But the inn endures! Been in my family for four generations, and it\'ll take more than a few walking corpses to close our doors. Though I wouldn\'t say no to someone dealing with the problem...",
                speaker_override: None,
                choices: [
                    (
                        text: "We might be able to help.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Stay strong, friend.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "Ha! That\'s the spirit! You take care of whatever\'s lurking in the Harrow Downs, and your next stay is on the house. How\'s that for motivation?",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            6: (
                id: 6,
                text: "Of course! Let me help you manage your party.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [
                    OpenInnManagement(
                        innkeeper_id: "tutorial_innkeeper_town2",
                    ),
                ],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            7: (
                id: 7,
                text: "Of course. Here is what Innkeeper Mountain Pass is offering.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [
                    OpenMerchant(
                        npc_id: "tutorial_innkeeper_town2",
                    ),
                ],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [
                        MerchantOpenNode,
                    ],
                ),
            ),
        },
        speaker_name: Some("Innkeeper"),
        repeatable: true,
        associated_quest: Some(3),
        sdk_metadata: (
            managed_content: [
                MerchantBranchInsertion,
            ],
        ),
    ),
    (
        id: 10,
        name: "Merchant Mountain Pass Greeting",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "Ah, customers! Rare these days — most traders won\'t touch this pass with the dead stirring near the Harrow Downs and the cold creeping down from the north. But I stay. The brave souls who still travel this road need supplies, and they pay well for the privilege. What catches your eye?",
                speaker_override: None,
                choices: [
                    (
                        text: "Why are customers rare?",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "What kind of artifacts?",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "I\'d like to buy something.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Just browsing.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "The dead and the cold, mostly. This pass used to be a merchant\'s dream. Now I charge what I call the hazard fee. The dead are bad enough, but the cold from the north is stranger — travelers say it doesn\'t feel like weather. It feels like something decided it.",
                speaker_override: None,
                choices: [
                    (
                        text: "Brave of you.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell me about something else.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "Oh, you know - enchanted rings, blessed amulets, the occasional cursed item I haven\'t identified yet. Just kidding about that last one! Mostly. But seriously, I do have some genuine magical items if you\'ve got the coin.",
                speaker_override: None,
                choices: [
                    (
                        text: "Impressive stock.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "Brave or foolish, take your pick! But the guild motto is \'Fortune favors the bold trader.\' Or maybe it\'s \'Never trust a deal that sounds too good.\' I forget which.",
                speaker_override: None,
                choices: [
                    (
                        text: "Ha! Good luck to you.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "Let me show you what I\'ve got. Hazard prices, but worth every coin!",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [
                    OpenMerchant(
                        npc_id: "tutorial_merchant_town2",
                    ),
                ],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
        },
        speaker_name: Some("Merchant"),
        repeatable: true,
        associated_quest: None,
        sdk_metadata: (
            managed_content: [],
        ),
    ),
    (
        id: 11,
        name: "High Priest Mountain Pass Greeting",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "Greetings, travelers. I am the High Priest of this mountain pass temple. The dead walk near the Harrow Downs, and a stillness creeps down from the far north with each passing week. We stand between the living and both. How may I serve you?",
                speaker_override: None,
                choices: [
                    (
                        text: "Tell me about the undead.",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "How does the temple help?",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Blessings, priest.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Show me your wares.",
                        target_node: Some(7),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [
                                MerchantChoice,
                            ],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "They rise from the Harrow Downs with a purpose I have not seen before — directed, almost intelligent. Something woke in those ancient tombs. But I am more troubled by what comes from the north. The stillness there is not undeath. It is something else. Something that chose to stop the world rather than end it.",
                speaker_override: None,
                choices: [
                    (
                        text: "What can be done?",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell me more.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "We bless the roads, ward the waymarkers, and destroy the restless dead we find on the passes. It is holy work. The temple has also begun watching the north — the freezing of the Vaelgrim rivers, the snow that falls in silence. Something there has power over stillness itself, and that frightens me more than the walking dead.",
                speaker_override: None,
                choices: [
                    (
                        text: "Your work is admirable.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "The source must be eliminated. Destroy the Lich and its phylactery, and the undead plague will end. But such a task requires heroes of great courage and strength. The temple will provide what blessings we can.",
                speaker_override: None,
                choices: [
                    (
                        text: "We may be those heroes.",
                        target_node: Some(6),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell me something else.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "Thank you, friend. We do what we must in service of the light. Should you venture into the darkness, know that our prayers go with you.",
                speaker_override: None,
                choices: [
                    (
                        text: "I appreciate that.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            6: (
                id: 6,
                text: "Then may the divine powers grant you strength and wisdom. Return to us victorious, and the temple will celebrate your deeds for generations to come.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            7: (
                id: 7,
                text: "Of course. Here is what High Priest Mountain Pass is offering.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [
                    OpenMerchant(
                        npc_id: "tutorial_priest_town2",
                    ),
                ],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [
                        MerchantOpenNode,
                    ],
                ),
            ),
        },
        speaker_name: Some("High Priest"),
        repeatable: true,
        associated_quest: None,
        sdk_metadata: (
            managed_content: [
                MerchantBranchInsertion,
            ],
        ),
    ),

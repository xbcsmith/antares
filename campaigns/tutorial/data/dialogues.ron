[
    (
        id: 1,
        name: "Arcturus - The Eternal Wanderer",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "You find me between thoughts — a not-uncommon state. I am Arcturus. I have been called many things across many lives, but here, at the foot of this particular volcano, I am a wizard who has been waiting for exactly the sort of company that arrives when something interesting is about to happen. Shall I guess why you have come, or would you prefer to tell me yourself?",
                speaker_override: None,
                choices: [
                    (
                        text: "We need your help.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Who are you, truly?",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell us what you know of the Cosmic Weave.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Farewell.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "My knowledge comes from a great many incarnations. I have been a hermit, a king, a sailor who knew nothing about sailing. In this life I chose to slow down — to observe rather than to wander. Mount Ashkarron suits me. A mountain that still remembers how to change its shape is, I find, very good company. But you did not trek to my cave to hear about volcanoes.",
                speaker_override: None,
                choices: [
                    (
                        text: "Tell us what you know of the Weave.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We need your help.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "The Cosmic Weave — the fabric that holds every world, every plane, and every possibility together. For centuries it has frayed slowly at the edges, the sort of fraying most people mistake for ordinary bad luck. The Great Tremor. The Great Gloom. The Great Alignment. Each was a wound in the same cloth. Now something pulls from inside, and the tearing accelerates.",
                speaker_override: None,
                choices: [
                    (
                        text: "What can be done?",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "The goblin movements, the storms above the Ironpeaks, three of my arcane instruments gone missing in as many months — none of it coincidence. Before I can help further I need those instruments back. My astrolabe was taken to the Ancient Ruins. A sealed reliquary of mine ended up in the Harrow Downs. Recover them and I will open a path to the one person who sees the full picture.",
                speaker_override: None,
                choices: [
                    (
                        text: "We will recover your instruments.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We cannot yet. Perhaps later.",
                        target_node: Some(6),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "Good. My instruments are old and irreplaceable in ways I will explain when you return. The ruins crawl with kobolds and goblins, and the Harrow Downs opens its doors only to those paying close attention. Go carefully.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            6: (
                id: 6,
                text: "The world moves at its own pace whether you are watching or not. Come back when you are ready.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
        },
        speaker_name: Some("Arcturus"),
        repeatable: true,
        associated_quest: Some(0),
        sdk_metadata: (
            managed_content: [],
        ),
    ),
    (
        id: 2,
        name: "Aetheris - The Void-Drifter",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "*the smoke from a small fire curls strangely inward, and the figure in the hut notices you a half-second before you arrive* Ah. You are not who I thought you were. My apologies — the Void has a habit of coloring my expectations. I am Aetheris. I stepped through something I should not have, some years ago, and have been finding my footing ever since. I do not often receive visitors. Please, sit.",
                speaker_override: None,
                choices: [
                    (
                        text: "What did you step through?",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Who did you think we were?",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We need your help.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Farewell.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "A tear in the Cosmic Weave — a place where the fabric between this world and elsewhere had grown so thin that stepping through it was, embarrassingly, an accident. I meant to cross the room. I ended up somewhere I could not name, and when I found my way back I was here. In this forest. In this hut. I have been here since. It is, at least, quiet.",
                speaker_override: None,
                choices: [
                    (
                        text: "Can you help us?",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "That sounds disorienting.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "You remind me — slightly, around the eyes — of people I knew in a different form. I do that sometimes. The Void makes memories unreliable. I am told I have another half, somewhere. A version of me that did not fall through the tear. He would be better at explaining all of this. His name is Arcturus. His cave is at the foot of Mount Ashkarron, at the edge of the Dark Forest.",
                speaker_override: None,
                choices: [
                    (
                        text: "Take us to Arcturus.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We already know where to find him.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "The goblins you followed here are not acting on their own, I think. That is what I have been trying to tell someone. Something stirs in the deep wood and reaches further than goblins should. I can lead you to Arcturus — he will know more than I do, which is not a high bar at present, but it is true.",
                speaker_override: None,
                choices: [
                    (
                        text: "Yes, take us to him.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We will find him ourselves. Thank you.",
                        target_node: Some(6),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "*gathers his coat, which has one too many pockets* Good. The forest grows stranger after dark and I would rather not explain that to anyone else alone. Come.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            6: (
                id: 6,
                text: "Of course. You know your own path. I will be here if the forest leads you back this way.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
        },
        speaker_name: Some("Aetheris"),
        repeatable: false,
        associated_quest: Some(1),
        sdk_metadata: (
            managed_content: [],
        ),
    ),
    (
        id: 3,
        name: "Village Elder Town Square Greeting",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "Welcome, travelers. I have kept watch over this village for many years, and I tell you plainly: these are not ordinary troubled times. Strange creatures stir in the wilderness beyond the Dark Forest, goblin scouts range further than they should, and travelers speak of a cold spreading from somewhere in the far north. What brings you to our village?",
                speaker_override: None,
                choices: [
                    (
                        text: "Tell me about the village.",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Do you have any work for us?",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Farewell, elder.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Show me your wares.",
                        target_node: Some(6),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [
                                MerchantChoice,
                            ],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "Our village has stood for generations in the river valleys of Ashvale. We have endured floods, harsh winters, and the usual troubles of the road. But what stirs now feels different — larger. The goblins that raid our outlying farms are not disorganized scavengers. They move with purpose, as if directed by something that sees further than they do.",
                speaker_override: None,
                choices: [
                    (
                        text: "What kind of dangers?",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "I see. Tell me something else.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "Goblins have been raiding our outlying farms and driving farmers from their land. We thought it ordinary banditry — but the raids are too coordinated, the scouts too bold. Something stirs in the Dark Forest and the goblins are its outriders. We need capable hands to push them back before they grow bolder.",
                speaker_override: None,
                choices: [
                    (
                        text: "We\'ll handle the goblins.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Perhaps another time.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "Goblin raids, creatures grown unnaturally aggressive, whispers of something cold spreading from the north. The Cosmic Weave that holds this world together has been fraying at its edges, though few dare say so plainly. Each strange event fits the same wound.",
                speaker_override: None,
                choices: [
                    (
                        text: "I understand. What else can you tell me?",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "May the old roads carry you safely. Drive back the goblins and return when the deed is done — there is more I would tell you about what drives them, but first things first.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            6: (
                id: 6,
                text: "Of course. Here is what Village Elder Town Square is offering.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [
                    OpenMerchant(
                        npc_id: "tutorial_elder_village",
                    ),
                ],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [
                        MerchantOpenNode,
                    ],
                ),
            ),
        },
        speaker_name: Some("Village Elder"),
        repeatable: true,
        associated_quest: Some(4),
        sdk_metadata: (
            managed_content: [
                MerchantBranchInsertion,
            ],
        ),
    ),
    (
        id: 4,
        name: "Innkeeper Town Square Greeting",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "Welcome to the Cozy Hearth! Best beds in the Ashvale river valley, and I have it on good authority my stew is passable. These are strange times for travelers, I\'ll say that much. What can I do for you?",
                speaker_override: None,
                choices: [
                    (
                        text: "Tell me about your inn.",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Any interesting news?",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "I\'d like to manage my party.",
                        target_node: Some(6),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "I\'ll be going now.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Show me your wares.",
                        target_node: Some(7),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [
                                MerchantChoice,
                            ],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "Been running this place for fifteen years now. My father ran it before me, and his father before him. We\'ve housed everyone from simple farmers to legendary heroes. Well, maybe not legendary yet, but who\'s counting?",
                speaker_override: None,
                choices: [
                    (
                        text: "Sounds like you\'ve seen a lot.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell me something else.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "Travelers come through with wild tales these days. Word is there\'s a wizard up near Mount Ashkarron who\'s been asking questions, and goblins have been pushing further out of the Dark Forest than anyone\'s comfortable with. And then there\'s the cold reports from the north — travelers who came south through the Mountain Pass saying the rivers up there freeze mid-flow. But then again, there\'s always talk, isn\'t there?",
                speaker_override: None,
                choices: [
                    (
                        text: "Interesting. What else?",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "That I have! Why, just last month a group came through claiming they\'d seen a dragon. A DRAGON! Can you believe it? I told them that was just the ale talking.",
                speaker_override: None,
                choices: [
                    (
                        text: "Ha! Good story.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            6: (
                id: 6,
                text: "Of course! Let me help you manage your party.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [
                    OpenInnManagement(
                        innkeeper_id: "tutorial_innkeeper_town",
                    ),
                ],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            7: (
                id: 7,
                text: "Of course. Here is what InnKeeper Town Square is offering.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [
                    OpenMerchant(
                        npc_id: "tutorial_innkeeper_town",
                    ),
                ],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [
                        MerchantOpenNode,
                    ],
                ),
            ),
        },
        speaker_name: Some("Innkeeper"),
        repeatable: true,
        associated_quest: None,
        sdk_metadata: (
            managed_content: [
                MerchantBranchInsertion,
            ],
        ),
    ),
    (
        id: 5,
        name: "Merchant Town Square Greeting",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "Greetings, adventurer! You\'ve got the look of someone who needs quality goods and won\'t fuss about the provenance. I\'ve come down from the Mountain Pass road, which means I\'ve earned whatever price I\'m asking. What can I show you?",
                speaker_override: None,
                choices: [
                    (
                        text: "What are you selling?",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Where do you travel?",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "I\'d like to browse your wares.",
                        target_node: Some(6),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Not interested.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "Potions, weapons, armor, tools - if you need it, I\'ve probably got it! Or I can get it. The Merchants Guild has connections everywhere, you see.",
                speaker_override: None,
                choices: [
                    (
                        text: "Impressive network.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell me something else.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "All over — Ashvale\'s river valleys, the Mountain Pass, and once as far as the Glass Sea though I do not recommend that crossing. Being a traveling merchant means seeing the world and all its dangers. Lately the dangers have been more interesting than usual.",
                speaker_override: None,
                choices: [
                    (
                        text: "Sounds risky.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "What else can you tell me?",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "Oh yes! We merchants stick together. Information flows as freely as gold among guild members. It\'s how we stay ahead of trouble... and ahead of the competition!",
                speaker_override: None,
                choices: [
                    (
                        text: "Smart business.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "It can be! The roads are not what they were — goblin scouts this side of the Dark Forest, undead stirring near the Harrow Downs, and reports of an unnatural cold spreading from somewhere north of the Mountain Pass. The Guild tracks all of it, and prices have adjusted accordingly.",
                speaker_override: None,
                choices: [
                    (
                        text: "I\'ll keep that in mind.",
                        target_node: Some(1),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            6: (

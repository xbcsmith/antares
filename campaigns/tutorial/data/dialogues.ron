    (
        id: 1000,
        name: "Zhaya Recruitment Dialog",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "*opens eyes slowly* I have felt your approach for some time now. You have found the Astronomers Temple... few travelers come this far with purpose. I am Zhaya. I have journeyed from distant mountain monasteries following a sign written in the stars themselves. What brings you to this sacred place?",
                speaker_override: None,
                choices: [
                    (
                        text: "We are searching for capable companions for a perilous quest.",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell us about yourself.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We were just passing through. Farewell.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "A perilous quest... *rises from meditation, studying you carefully* I have kept vigil at this temple for seven days seeking a sign. Perhaps you are it. I search for the one true Astrologer — one who reads fate as it is written, not as we wish it to be. My path has grown cold here. Perhaps yours leads where the stars are pointing me.",
                speaker_override: None,
                choices: [
                    (
                        text: "Join us, Zhaya. Your skills and purpose are welcome.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [
                            RecruitToParty(
                                character_id: "tutorial_monk",
                            ),
                        ],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We would be glad to have you. Meet us at the inn?",
                        target_node: Some(5),
                        conditions: [],
                        actions: [
                            TriggerEvent(
                                event_name: "recruit_character_to_inn",
                            ),
                        ],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We need to think on it. Perhaps another time.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "I was raised among the mountain monasteries of the Eastern Peaks — an order that trains body and spirit as one. After years of discipline I began to dream of the Astrologer\'s Path, a celestial map leading to a great truth. My elders thought me obsessed. I thought them afraid. So I left, following the stars east and south until they brought me to this temple — carved with the very symbols from my dreams.",
                speaker_override: None,
                choices: [
                    (
                        text: "You sound exactly like the sort of person we need.",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "A fascinating search. We will leave you to it.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "Then I stand with you. My fists, my training, and my purpose — all walk this path alongside yours. Let us go.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "The inn — yes. I will secure my belongings and meet you there when you are ready. May the stars light your path until then.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
        },
        speaker_name: Some("Zhaya"),
        repeatable: false,
        associated_quest: None,
        sdk_metadata: (
            managed_content: [],
        ),
    ),
    (
        id: 1001,
        name: "Jyeshtha - The Glass Sea Watcher",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "*opens his eyes slowly, their gaze deep and distant* You have arrived. I am Jyeshtha — keeper of this temple, watcher of the paths between worlds. I have observed your approach across many timelines. There is something I must ask of you.",
                speaker_override: None,
                choices: [
                    (
                        text: "What would you ask of us?",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell us of this temple.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We cannot stay long. Farewell.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "Decades ago I found the jade icosahedron — a relic forged by the first astronomers to see across worlds and through time. The only instrument capable of mapping exactly where the Cosmic Weave is tearing and how fast. I found it. And then a lich king called Eonir Xavian Stalix took it from me. Eonir does not want to destroy Velmoria — he wants to stop it, to freeze one perfect moment before the fraying Weave takes everything he loved a second time. But a relic built to observe cannot survive being used to arrest all motion. Every day he holds it, the stillness bleeds further from Vaelgrim and the fraying elsewhere accelerates. I cannot retrieve it myself — my sight anchors me here, forever watching, never walking. I need someone to walk the road I cannot.",
                speaker_override: None,
                choices: [
                    (
                        text: "We will search for this relic.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [
                            StartQuest(
                                quest_id: 8,
                            ),
                        ],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Where should we begin looking?",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "This sounds beyond us.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "This temple was raised when the first astronomers mapped the paths between worlds. The stones are aligned with constellations that no longer appear in your sky — because those stars belong to realms adjacent to this one. I have kept vigil here since before the Glass Sea had a name, watching timelines the way other men watch weather. But the pattern I have watched for decades grows desperate.",
                speaker_override: None,
                choices: [
                    (
                        text: "What relic do you seek?",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Fascinating. We will leave you to your studies.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "*bows his head* My gratitude, travelers. When you stand before Eonir, you may find not a monster but a mourning king still turning the relic over in hands that no longer feel the cold. He will not simply hand it over — some part of him still believes stillness is mercy. Speak with him or take it by force, but bring it back. The Weave cannot wait.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "The relic was last held by a traveling scholar, but those records are centuries old. I have reached across time and seen only fragments — a cold stone floor, the sound of frozen water, darkness spreading outward from a single source. The stillness comes from the north, from Vaelgrim, from the Frostspire Peaks. That is where your road must lead.",
                speaker_override: None,
                choices: [
                    (
                        text: "Then we will begin searching.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [
                            StartQuest(
                                quest_id: 8,
                            ),
                        ],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We are not ready for such a task.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
        },
        speaker_name: Some("Jyeshtha"),
        repeatable: false,
        associated_quest: Some(8),
        sdk_metadata: (
            managed_content: [],
        ),
    ),
    (
        id: 1002,
        name: "Lost Ranger Skill Trainer Dialogue",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "Greetings, adventurer. I am a ranger of this region, and I can help you hone the skills that keep you alive in the wild. Tracking, stealth, trap work — the craft of surviving in places where the road ends. What would you learn?",
                speaker_override: None,
                choices: [
                    (
                        text: "I seek skill training.",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [
                                SkillTrainerChoice,
                            ],
                        ),
                    ),
                    (
                        text: "Farewell.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "Good. Let us see what you already know and build from there.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [
                    OpenSkillTraining(
                        npc_id: "npc_1",
                    ),
                ],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [
                        SkillTrainerOpenNode,
                    ],
                ),
            ),
        },
        speaker_name: Some("Lost Ranger"),
        repeatable: true,
        associated_quest: None,
        sdk_metadata: (
            managed_content: [
                SkillTrainerTemplateTree,
            ],
        ),
    ),
    (
        id: 1003,
        name: "Isolde Dawnfang Recruitment",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "*you find her kneeling in prayer before the altar, her war mace resting across her knees* You interrupt my devotions — but perhaps that is the will of the Radiant Shield. I am called Isolde. I serve as a War Cleric in these lands. What brings you to this temple?",
                speaker_override: None,
                choices: [
                    (
                        text: "We seek capable companions for a perilous journey.",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell me about yourself.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "What is the Radiant Shield?",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Our apologies for the interruption. Farewell.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "*rises and studies you carefully, eyes sharp beneath her helm* Companions. You carry yourselves like people who have seen real battle — not mercenaries chasing coin. I have been searching for exactly that: a cause worth fighting for and a company worthy of standing beside. Tell me what darkness you face.",
                speaker_override: None,
                choices: [
                    (
                        text: "We battle the shadow threatening these lands — and those too weak to fight back.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We could use both a healer and a fighter. You appear to be both.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Our path is still forming. Perhaps another time.",
                        target_node: Some(8),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "I come from... a distant realm. My training is both martial and divine — war mace, sacred litanies, solar energy channeled through shield and blade. Let us say I grew weary of watching conflict from a safe distance and chose to enter it. The people who needed protecting could not wait for someone else to step forward.",
                speaker_override: None,
                choices: [
                    (
                        text: "An unusual path for a War Cleric.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We could use someone of your conviction. Travel with us.",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "The Radiant Shield is not a church or an order — it is a vow I made to myself. To use every gift I possess in defense of the innocent. Divine light, the strength of my arm, and the will to stand between harm and those who cannot defend themselves. I need no throne\'s permission and no temple\'s blessing to honour it.",
                speaker_override: None,
                choices: [
                    (
                        text: "An admirable purpose. We share it. Join us.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Tell me more about yourself.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Farewell, Isolde. May the Radiant Shield guide you.",
                        target_node: None,
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "*a slow nod, something resolute settling in her expression* Then it is decided. I did not leave comfort and safety behind to stand still in a temple doorway. The question is only how we proceed.",
                speaker_override: None,
                choices: [
                    (
                        text: "Join our party now, Isolde.",
                        target_node: Some(6),
                        conditions: [],
                        actions: [
                            RecruitToParty(
                                character_id: "isolde",
                            ),
                        ],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "Meet us at the inn when you are ready.",
                        target_node: Some(7),
                        conditions: [],
                        actions: [
                            TriggerEvent(
                                event_name: "recruit_character_to_inn",
                            ),
                        ],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "We need more time to consider.",
                        target_node: Some(8),
                        conditions: [],
                        actions: [],
                        ends_dialogue: true,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            6: (
                id: 6,
                text: "*clasps gauntlet to chest and bows her head* Then we march together. I will not squander your trust — or my own. Whatever stands against the innocent will learn the meaning of divine justice delivered by an unrelenting hand. Lead on.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            7: (
                id: 7,
                text: "The inn — understood. Gather your people and I will meet you there. Do not keep me waiting too long. I have been still far too long already.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            8: (
                id: 8,
                text: "*inclines her head* Take the time you need. I will remain here in service of this temple until I am called elsewhere. Should your path lead you back to this altar, I will be ready.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
        },
        speaker_name: Some("Isolde Dawnfang"),
        repeatable: false,
        associated_quest: None,
        sdk_metadata: (
            managed_content: [],
        ),
    ),
    (
        id: 1004,
        name: "The Sovereign\'s Soliloquy",
        root_node: 1,
        nodes: {
            1: (
                id: 1,
                text: "*he raises his long, golden fingers, tracing a line in the air as if pulling an invisible thread* You stand in my domain of rest. Tell me, wanderer, does your journey feel like a rush toward a destination, or a slow drift into the unknown?",
                speaker_override: None,
                choices: [
                    (
                        text: "A rush toward a destination.",
                        target_node: Some(2),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "A slow drift into the unknown.",
                        target_node: Some(3),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "I am simply trying to survive.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "I will not bargain with a lich.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [
                            StartQuest(
                                quest_id: 9,
                            ),
                            SetFlag(
                                flag_name: "eonir_combat_triggered",
                                value: true,
                            ),
                        ],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            2: (
                id: 2,
                text: "Then your life is a sprint across a field of seconds. A noble, if frantic, pursuit. But remember... even the fastest runner eventually finds the end of the path.",
                speaker_override: None,
                choices: [
                    (
                        text: "Indeed. Time grows short — return the relic, Eonir.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            3: (
                id: 3,
                text: "The drift is where true observation lies. To see the world as it unfolds, rather than what it demands of you. You have a patient soul.",
                speaker_override: None,
                choices: [
                    (
                        text: "We drift toward a single purpose: reclaiming the relic.",
                        target_node: Some(4),
                        conditions: [],
                        actions: [],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "*a faint, weary smile touches his skeletal lips* Survival is the most fundamental geometry of existence. Let us ensure yours lasts long enough to find the Relic I hold.",
                speaker_override: None,
                choices: [
                    (
                        text: "Return the relic to Jyeshtha. We have no further quarrel.",
                        target_node: Some(6),
                        conditions: [],
                        actions: [
                            GiveItems(
                                items: [
                                    (210, 1),
                                ],
                            ),
                            SetFlag(
                                flag_name: "eonir_relic_returned",
                                value: true,
                            ),
                            StartQuest(
                                quest_id: 9,
                            ),
                            CompleteQuestStage(
                                quest_id: 9,
                                stage_number: 1,
                            ),
                            CompleteQuestStage(
                                quest_id: 8,
                                stage_number: 1,
                            ),
                        ],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                    (
                        text: "There is no negotiation. This ends in combat.",
                        target_node: Some(5),
                        conditions: [],
                        actions: [
                            StartQuest(
                                quest_id: 9,
                            ),
                            SetFlag(
                                flag_name: "eonir_combat_triggered",
                                value: true,
                            ),
                        ],
                        ends_dialogue: false,
                        sdk_metadata: (
                            managed_content: [],
                        ),
                    ),
                ],
                conditions: [],
                actions: [],
                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            5: (
                id: 5,
                text: "*the cold deepens around you and Eonir\'s form ripples with shadow energy* You choose violence over reason. So be it. Let stillness decide between us.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            6: (
                id: 6,
                text: "*a long silence, then the jade icosahedron drifts slowly toward you* The Weave called this necessary. I called it inevitable. Take it — and tell Jyeshtha the Sovereign of Stillness steps aside. For now.",
                speaker_override: None,
                choices: [],
                conditions: [],
                actions: [],
                is_terminal: true,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
        },
        speaker_name: Some("Eonir"),
        repeatable: false,
        associated_quest: None,
        sdk_metadata: (
            managed_content: [],
        ),
    ),
]
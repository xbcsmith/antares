                is_terminal: false,
                sdk_metadata: (
                    managed_content: [],
                ),
            ),
            4: (
                id: 4,
                text: "Shiny... Chief\'s favorite shiny thing... Wanted it... so pretty... Now dying for it... Stupid... so stupid...",
                speaker_override: None,
                choices: [
                    (
                        text: "I\'ll avenge you.",
                        target_node: Some(6),
                        conditions: [],
